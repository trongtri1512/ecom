# ---- Database ----
POSTGRES_USER=scan
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=scan

# ---- App ----
# API key: agent phải gửi đúng key này qua header X-API-Key. ĐỔI thành chuỗi ngẫu nhiên.
API_KEY=doi-thanh-chuoi-ngau-nhien
# Origin của web app. Để * cho đơn giản, hoặc đặt domain: https://scan.congty.com
CORS_ORIGINS=*
# Cổng expose (Dokploy proxy vào đây).
APP_PORT=8000
# Cửa sổ "quét lại KHÔNG tính trùng" (giây) kể từ lần quét đầu của 1 mã.
# Trong khoảng này: quét lại bị bỏ qua êm. Quá khoảng này: tính trùng + báo email.
DUP_GRACE_SECONDS=60
# Mật khẩu xác nhận khi XOÁ dòng (kiểm ở server). ĐỔI cho an toàn.
DELETE_PASSWORD=1512

# ---- Auto import Excel lên imv.ops.vnfai.com ----
# Bật tính năng auto import (true/false)
AUTO_IMPORT_ENABLED=false
# Đủ bao nhiêu đơn 'đã lấy hàng' (chưa import) của 1 hãng thì tự upload
AUTO_IMPORT_BATCH=100
OPS_URL=https://imv.ops.vnfai.com
OPS_USER=tai_khoan_ops_cua_ban
OPS_PASS=mat_khau_ops_cua_ban
# Ánh xạ ĐVVC (tên trên Scan Ecom) -> ID template và Tên đối tác trên OPS (JSON).
# OPS_CARRIER_MAP='{"SPX":{"template_id":2,"partner":"SPX Express"},"J&T":{"template_id":2,"partner":"J&T Express"},"GHN":{"template_id":2,"partner":"Giao Hàng Nhanh"},"Best":{"template_id":2,"partner":"BEST Express"},"Viettel":{"template_id":2,"partner":"Viettel Post"}}'
OPS_CARRIER_MAP={"SPX":{"template_id":2,"partner":"SPX Express"},"J&T":{"template_id":2,"partner":"J&T Express"},"GHN":{"template_id":2,"partner":"Giao Hàng Nhanh"},"Best":{"template_id":2,"partner":"BEST Express"},"Viettel":{"template_id":2,"partner":"Viettel Post"}}

# ---- Email báo mã trùng ----
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email-gui@congty.com
SMTP_PASS=app-password
SMTP_FROM=email-gui@congty.com
SMTP_TLS=true
# Email Admin nhận cảnh báo mã trùng:
ADMIN_EMAIL=admin@congty.com
