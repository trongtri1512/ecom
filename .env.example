# ---- Database ----
POSTGRES_USER=scan
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=scan

# ---- App ----
# API key: agent phải gửi đúng key này qua header X-API-Key. ĐỔI thành chuỗi ngẫu nhiên.
API_KEY=doi-thanh-chuoi-ngau-nhien
# Origin của web app. Để * cho đơn giản, hoặc đặt domain: https://scan.congty.com
CORS_ORIGINS=*
# Cổng expose (Dokploy proxy vào đây).
APP_PORT=8000
# Cửa sổ "quét lại KHÔNG tính trùng" (giây) kể từ lần quét đầu của 1 mã.
# Trong khoảng này: quét lại bị bỏ qua êm. Quá khoảng này: tính trùng + báo email.
DUP_GRACE_SECONDS=60

# ---- Email báo mã trùng ----
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email-gui@congty.com
SMTP_PASS=app-password
SMTP_FROM=email-gui@congty.com
SMTP_TLS=true
# Email Admin nhận cảnh báo mã trùng:
ADMIN_EMAIL=admin@congty.com
