[server]
; URL backend (Dokploy). KHÔNG có dấu / ở cuối.
url = https://scan.example.com
; API key phải khớp biến API_KEY của backend.
api_key = change-me

[agent]
; Tên máy quét này (hiện ở cột "Nguồn" trong web app).
name = quầy-đóng-gói-1
; Có mở cửa sổ giao diện lúc khởi động không? (true = hiện cửa sổ, false = chạy
; thẳng xuống khay, mở cửa sổ sau bằng cách nhấp đúp icon khay).
show_window = true

[scanner]
; Ngưỡng phân biệt "quét" vs "gõ tay": nếu khoảng cách giữa 2 phím < giá trị này
; (giây) thì coi là do máy quét gõ. Máy quét gõ rất nhanh (~0.01-0.03s/ký tự).
inter_key_timeout = 0.05
; Độ dài tối thiểu của 1 mã hợp lệ (bỏ qua chuỗi quá ngắn khi gõ tay lạc).
min_length = 6
; Bật/tắt tiếng bíp phản hồi.
beep = true

[input]
; Nguồn nhận mã vận đơn:
;   barcode  = chỉ máy quét bàn phím (mặc định)
;   camera   = chỉ camera
;   both     = song song cả 2, dedup chung
source = barcode

[camera]
; Camera source (dùng khi input.source = camera hoặc both):
;   0, 1, 2...      = webcam local (index device)
;   rtsp://user:pass@ip:554/stream  = IP camera RTSP
;   http://ip:8080/video            = HTTP MJPEG (VD IP Webcam app điện thoại)
source = 0
; Độ phân giải video. 640x480 nhẹ, 1280x720 nét hơn nhưng chậm.
width = 640
height = 480
; FPS mục tiêu cho decode (không quá cao để đỡ CPU).
fps = 15
; Reading zone: phần trăm giữa frame để chấp nhận mã (0.6 = 60% giữa).
; Mã ngoài zone bị bỏ qua -> user đặt kiện đúng vị trí mới scan.
zone_ratio = 0.6
; Cùng mã không gửi lại trong bao nhiêu giây (chống spam khi kiện đứng yên).
dedup_seconds = 3.0
